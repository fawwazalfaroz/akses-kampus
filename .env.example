# Koneksi PostgreSQL (Neon: gunakan connection string "pooled")
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Opsional: koneksi langsung (non-pooler) khusus untuk migrasi
# DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# Rahasia untuk menandatangani sesi admin (minimal 32 karakter acak)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Akun admin pertama (dibuat otomatis saat build/db:setup bila belum ada)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin
